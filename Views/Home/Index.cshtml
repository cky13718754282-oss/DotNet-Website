@model List<Geekspace.Models.LearningResource>
@using Geekspace.Models

@{
    ViewData["Title"] = "Cybersecurity Learning Hub";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var resourceCount = ViewBag.ResourceCount as int? ?? 0;
    var categoryCount = ViewBag.CategoryCount as int? ?? 0;
    var commentCount = ViewBag.CommentCount as int? ?? 0;
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow eyebrow-light">Explore. Practise. Discuss.</span>
                <h1>Build skills that make the digital world safer.</h1>
                <p class="hero-lead">
                    Geekspace turns cybersecurity concepts into practical learning.
                    Discover curated articles, videos, virtual labs and simulations,
                    then learn together with the community.
                </p>
                <div class="hero-actions">
                    <a asp-controller="Resource" asp-action="Index" class="btn btn-accent btn-lg">
                        Explore the library <span aria-hidden="true">→</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-ghost-light btn-lg">
                            Create free account
                        </a>
                    }
                </div>
                <div class="hero-proof" aria-label="Platform highlights">
                    <div><strong>@resourceCount</strong><span>learning resources</span></div>
                    <div><strong>@categoryCount</strong><span>focused topics</span></div>
                    <div><strong>@commentCount</strong><span>community posts</span></div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-visual" aria-label="Cybersecurity learning paths">
                    <div class="signal signal-one"></div>
                    <div class="signal signal-two"></div>
                    <div class="visual-card visual-card-main">
                        <span class="visual-kicker">LEARNING PATH</span>
                        <div class="visual-icon">01</div>
                        <h2>Cybersecurity Foundations</h2>
                        <div class="progress-track"><span></span></div>
                        <small>Knowledge that protects people and systems.</small>
                    </div>
                    <div class="visual-card visual-card-float">
                        <span>● LIVE LAB</span>
                        <strong>Safe practice environment</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Choose your direction</span>
                <h2>Learn by topic</h2>
                <p>Start with a foundation or dive straight into a practical discipline.</p>
            </div>
            <a asp-controller="Category" asp-action="Index" class="text-link">View all topics →</a>
        </div>
        <div class="topic-grid">
            @for (var i = 0; i < categories.Count; i++)
            {
                var category = categories[i];
                var number = (i + 1).ToString("00");
                <a class="topic-card" asp-controller="Category" asp-action="Details" asp-route-id="@category.Id">
                    <span class="topic-number">@number</span>
                    <h3>@category.Name</h3>
                    <p>@category.Description</p>
                    <span class="topic-meta">@category.Resources.Count(r => r.IsPublished) resources</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="section-block section-tinted">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Recently published</span>
                <h2>Continue exploring</h2>
                <p>Fresh learning material selected for practical progress.</p>
            </div>
            <a asp-controller="Resource" asp-action="Index" class="text-link">Browse the library →</a>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h3>No published resources yet</h3>
                <p>New material will appear here as soon as it is published.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var resource in Model)
                {
                    var hasImage = !string.IsNullOrWhiteSpace(resource.MediaUrl) &&
                        new[] { ".jpg", ".jpeg", ".png", ".webp" }.Contains(System.IO.Path.GetExtension(resource.MediaUrl).ToLowerInvariant());
                    <div class="col">
                        <article class="resource-card">
                            <a class="resource-media" asp-controller="Resource" asp-action="Details" asp-route-id="@resource.Id">
                                @if (hasImage)
                                {
                                    <img src="@resource.MediaUrl" alt="" />
                                }
                                else
                                {
                                    <span class="resource-placeholder">@resource.Type.ToString().Substring(0, 1)</span>
                                }
                                <span class="type-pill">@resource.Type</span>
                            </a>
                            <div class="resource-card-body">
                                <span class="resource-topic">@resource.Category?.Name</span>
                                <h3><a asp-controller="Resource" asp-action="Details" asp-route-id="@resource.Id">@resource.Title</a></h3>
                                <p>@resource.Description</p>
                                <div class="resource-card-footer">
                                    <span>@resource.CreatedDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</span>
                                    <a asp-controller="Resource" asp-action="Details" asp-route-id="@resource.Id"
                                       aria-label="Open @resource.Title">Open →</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <div class="cta-panel">
            <div>
                <span class="eyebrow eyebrow-light">Community powered learning</span>
                <h2>Questions become clearer when we learn together.</h2>
                <p>Register to join resource discussions and manage your learning activity.</p>
            </div>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-lg">Join Geekspace</a>
        </div>
    </div>
</section>
