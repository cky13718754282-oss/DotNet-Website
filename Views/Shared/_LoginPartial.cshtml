@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roleLabel = "Member";

    if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Root"))
    {
        roleLabel = "Root";
    }
    else if (currentUser != null && await UserManager.IsInRoleAsync(currentUser, "Admin"))
    {
        roleLabel = "Admin";
    }

    <div class="dropdown account-menu">
        <button class="account-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="account-avatar" aria-hidden="true">@(UserManager.GetUserName(User)?[0].ToString().ToUpperInvariant() ?? "U")</span>
            <span class="account-label d-none d-xl-flex">
                <small>@roleLabel</small>
                <strong>@UserManager.GetUserName(User)</strong>
            </span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header">Signed in as @roleLabel</h6></li>
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Account settings</a></li>
            <li><a class="dropdown-item" asp-controller="Activity" asp-action="Index">Manage activity</a></li>
            @if (roleLabel is "Admin" or "Root")
            {
                <li><hr class="dropdown-divider" /></li>
                <li><h6 class="dropdown-header">Administration</h6></li>
                <li><a class="dropdown-item" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Resource" asp-action="Create">Create resource</a></li>
                <li><a class="dropdown-item" asp-controller="UserManagement" asp-action="Index">Manage users</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="dropdown-item text-danger">Sign out</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <div class="auth-links">
        <a class="btn btn-link" asp-area="Identity" asp-page="/Account/Login">Sign in</a>
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Register">Join free</a>
    </div>
}
