@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script>
        document.documentElement.setAttribute(
            "data-bs-theme",
            localStorage.getItem("geekspace-theme") || "light"
        );
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Geekspace is a practical cybersecurity learning platform with articles, videos, labs and community discussions." />
    <meta name="theme-color" content="#071226" />
    <title>@ViewData["Title"] | Geekspace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="utility-bar">
            <div class="container d-flex justify-content-between align-items-center">
                <span>Practical cybersecurity learning, built for curious minds.</span>
                <span class="d-none d-md-inline">Learn safely. Practise ethically.</span>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg" aria-label="Primary navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="Geekspace home">
                    <span class="brand-mark" aria-hidden="true">G</span>
                    <span class="brand-wordmark">Geek<span>space</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav"
                        aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="primaryNav">
                    <ul class="navbar-nav mx-lg-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Resource" ? "active" : "")"
                               asp-controller="Resource" asp-action="Index">Learning Library</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Category" ? "active" : "")"
                               asp-controller="Category" asp-action="Index">Topics</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Activity" ? "active" : "")"
                                   asp-controller="Activity" asp-action="Index">My Activity</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Root"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "AdminDashboard" ? "active" : "")"
                                   asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
                            </li>
                        }
                    </ul>

                    <div class="nav-actions">
                        <form class="nav-search" role="search" method="get" asp-controller="Resource" asp-action="Index">
                            <label class="visually-hidden" for="navSearch">Search resources</label>
                            <span aria-hidden="true">⌕</span>
                            <input id="navSearch" type="search" name="search" placeholder="Search library"
                                   value="@(Context.Request.Query["search"])" />
                        </form>
                        <button id="themeToggle" class="icon-button" type="button"
                                aria-label="Switch colour theme" title="Switch colour theme">
                            <span id="themeIcon" aria-hidden="true">☾</span>
                        </button>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
    {
        <div class="flash-message-wrap" aria-live="polite">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <strong>Success.</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Action required.</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    }

    <main id="main-content" class="site-main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 py-5">
                <div class="col-lg-5">
                    <a class="footer-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true">G</span>
                        <span class="brand-wordmark">Geek<span>space</span></span>
                    </a>
                    <p class="footer-copy mt-3">
                        A community learning system for building practical cybersecurity knowledge
                        through trusted resources, hands-on activities and discussion.
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <h2 class="footer-heading">Explore</h2>
                    <ul class="footer-links">
                        <li><a asp-controller="Resource" asp-action="Index">Learning Library</a></li>
                        <li><a asp-controller="Category" asp-action="Index">Topic Directory</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-4">
                    <h2 class="footer-heading">Member access</h2>
                    <ul class="footer-links">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a asp-controller="Activity" asp-action="Index">Manage activity</a></li>
                            <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Account settings</a></li>
                        }
                        else
                        {
                            <li><a asp-area="Identity" asp-page="/Account/Register">Create an account</a></li>
                            <li><a asp-area="Identity" asp-page="/Account/Login">Sign in</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; 2026 Geekspace Learning System</span>
                <span>Developed with ASP.NET Core and SQLite</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
