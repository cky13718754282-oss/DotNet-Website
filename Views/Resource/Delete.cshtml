@model Geekspace.Models.LearningResource
@{ ViewData["Title"] = "Delete Resource"; }

<section class="form-page">
    <div class="container narrow-container">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a asp-action="Index">Learning Library</a><span>/</span><span>Delete</span>
        </nav>
        <div class="danger-card">
            <span class="danger-icon" aria-hidden="true">!</span>
            <span class="eyebrow text-danger">Permanent action</span>
            <h1>Delete this resource?</h1>
            <p>This removes the resource and its associated discussion from the database.</p>
            <div class="delete-summary">
                <strong>@Model.Title</strong>
                <span>@(Model.Category?.Name ?? "Uncategorised") · @Model.Type</span>
            </div>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="form-actions">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Keep resource</a>
                    <button type="submit" class="btn btn-danger">Delete permanently</button>
                </div>
            </form>
        </div>
    </div>
</section>
