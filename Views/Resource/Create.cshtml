@model Geekspace.Models.LearningResource
@{ ViewData["Title"] = "Create Resource"; }

<section class="form-page">
    <div class="container form-container">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a asp-action="Index">Learning Library</a><span>/</span><span>Create</span>
        </nav>
        <div class="form-heading">
            <span class="eyebrow">Content administration</span>
            <h1>Create a learning resource</h1>
            <p>Add quality content to the public library or save it as a draft.</p>
        </div>
        <form asp-action="Create" class="form-card">
            <partial name="_ResourceForm" model="Model" />
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create resource</button>
            </div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
