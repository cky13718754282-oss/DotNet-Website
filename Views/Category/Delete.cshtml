@model Geekspace.Models.Category
@{ ViewData["Title"] = "Delete Topic"; }

<section class="form-page">
    <div class="container narrow-container">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a asp-action="Index">Topic Directory</a><span>/</span><span>Delete</span>
        </nav>
        <div class="danger-card">
            <span class="danger-icon" aria-hidden="true">!</span>
            <span class="eyebrow text-danger">Permanent action</span>
            <h1>Delete this topic?</h1>
            <p>Only delete an empty topic. Resources linked to it may prevent this action.</p>
            <div class="delete-summary">
                <strong>@Model.Name</strong>
                <span>@Model.Description</span>
            </div>
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="form-actions">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Keep topic</a>
                    <button type="submit" class="btn btn-danger">Delete permanently</button>
                </div>
            </form>
        </div>
    </div>
</section>
