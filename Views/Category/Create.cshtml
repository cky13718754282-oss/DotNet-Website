@model Geekspace.Models.Category
@{ ViewData["Title"] = "Create Topic"; }

<section class="form-page">
    <div class="container narrow-container">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a asp-action="Index">Topic Directory</a><span>/</span><span>Create</span>
        </nav>
        <div class="form-heading">
            <span class="eyebrow">Content administration</span>
            <h1>Create a topic</h1>
            <p>Use a clear name and description to help learners navigate the library.</p>
        </div>
        <form asp-action="Create" class="form-card">
            <partial name="_CategoryForm" model="Model" />
            <div class="form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create topic</button>
            </div>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
