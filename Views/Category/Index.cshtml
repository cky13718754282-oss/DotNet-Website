@model IEnumerable<Geekspace.Models.Category>

@{
    ViewData["Title"] = "Topic Directory";
    var categories = Model.ToList();
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("Root");
}

<section class="page-hero compact">
    <div class="container">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a><span>/</span><span>Topics</span>
        </nav>
        <div class="page-hero-row">
            <div>
                <span class="eyebrow eyebrow-light">Structured discovery</span>
                <h1>Topic Directory</h1>
                <p>Choose a focused area and follow the resources that match your goals.</p>
            </div>
            @if (isAdmin)
            {
                <a asp-action="Create" class="btn btn-accent btn-lg">+ Add topic</a>
            }
        </div>
    </div>
</section>

<section class="section-block">
    <div class="container">
        <div class="topic-grid large">
            @for (var i = 0; i < categories.Count; i++)
            {
                var item = categories[i];
                <article class="topic-card">
                    <span class="topic-number">@((i + 1).ToString("00"))</span>
                    <h2><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></h2>
                    <p>@item.Description</p>
                    <div class="topic-card-footer">
                        <span>@item.Resources.Count(r => r.IsPublished) published resources</span>
                        <a asp-action="Details" asp-route-id="@item.Id">Explore →</a>
                    </div>
                    @if (isAdmin)
                    {
                        <div class="admin-card-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Delete</a>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
</section>
