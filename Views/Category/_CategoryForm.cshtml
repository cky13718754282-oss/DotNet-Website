@model Geekspace.Models.Category

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="field-group">
    <label asp-for="Name" class="form-label">Topic name</label>
    <input asp-for="Name" class="form-control" placeholder="For example, Network Security" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="field-group mt-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="5"
              placeholder="Explain what learners can expect from this topic"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
